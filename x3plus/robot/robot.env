# The X3 Plus's devices and settings, read by the systemd units here (robot/*.service).
# Stable paths, so USB re-enumeration cannot shuffle them. A robot.local.env next to robot/
# (in ~/roboarm) overrides any of these -- cameras/sonix.env is one.
ROBOARM_SERIAL=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
ROBOARM_WRIST_CAM=/dev/v4l/by-id/usb-046d_Logitech_Webcam_C930e_3E3B7A2E-video-index0
ROBOARM_CAMERA=c930e
ROBOARM_DETECTOR_URL=http://127.0.0.1:8760
# The vision service's detector (vision_service/detector.py): since 2026-09-14 the prompt-free
# YOLOE-26s segmenter, models/yoloe-26s-seg-pf.pt (its sibling .engine serves when there is one).
# Its label is nonsense and ignored; the mask counts. Measured on the lab's frames, conf 0.10:
# yoloe-26s-seg-pf red cube 0.86, tagged wooden cube 0.61, 41 ms; yoloe-26m-seg-pf 0.85 / 0.85,
# 55 ms; the COCO yolo26n/s-seg find the tagged cube NOT at all. Any Ultralytics segmenter can be
# served instead through ROBOARM_VISION_MODEL (in robot.local.env).
ROBOARM_VISION_IMGSZ=640
ROBOARM_VISION_CONF=0.25
# our code from ~/roboarm, and Yahboom's Rosmaster_Lib as vendored by tools/vendor_sdk.sh
PYTHONPATH=/home/jetson/roboarm:/home/jetson/roboarm/vendor
PYTHONUNBUFFERED=1

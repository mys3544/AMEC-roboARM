# The X3 Plus's arm, wrist camera and pick, for the console (port 8080: /pick/* and the panel).
# A systemd user unit, installed by robot/setup.sh; `systemctl --user status roboarm-web`,
# `journalctl --user -u roboarm-web -f`. It holds the serial port and the camera while it runs.
[Unit]
Description=RoboARM X3 Plus arm and pick (port 8080)
Conflicts=roboarm-bridge.service
Wants=roboarm-vision.service
After=roboarm-vision.service

[Service]
WorkingDirectory=%h/roboarm
EnvironmentFile=%h/roboarm/robot/robot.env
EnvironmentFile=-%h/roboarm/robot.local.env
ExecStart=%h/roboarm/.venv/bin/python tools/webapp.py --host 0.0.0.0 --port 8080
# SIGINT, so Python unwinds and the arm is left holding (Arm.__exit__), never limp
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

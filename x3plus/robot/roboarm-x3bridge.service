# The X3 Plus's arm, wrist camera and jobs on port 8761 -- the M3's surface (roboshared.serve), for the
# console's arm card (tools/x3bridge.py). A systemd user unit, installed by robot/setup.sh;
# `systemctl --user status roboarm-x3bridge`. It holds the serial port and the camera while it runs.
[Unit]
Description=RoboARM X3 Plus bridge and jobs (port 8761)
Wants=roboarm-vision.service
After=roboarm-vision.service
Conflicts=roboarm-web.service roboarm-bridge.service

[Service]
WorkingDirectory=%h/roboarm
EnvironmentFile=%h/roboarm/robot/robot.env
EnvironmentFile=-%h/roboarm/robot.local.env
ExecStart=%h/roboarm/.venv/bin/python tools/x3bridge.py
# SIGINT, so Python unwinds and the arm is left holding, never limp
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

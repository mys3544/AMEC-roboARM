# The stock Yahboom (Sonix) wrist camera, fitted until 2026-09-24.
# To go back to it, on the robot, with the Sonix plugged in again:
#   cp cameras/sonix.env .env
#   docker compose --profile bridge up -d --force-recreate bridge
# and on the laptop, before starting the panel: set ROBOARM_CAMERA=sonix
# Delete .env to return to the C930e.
ROBOARM_CAMERA=sonix
ROBOARM_WRIST_CAM_DEV=/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._USB_2.0_Camera-video-index0

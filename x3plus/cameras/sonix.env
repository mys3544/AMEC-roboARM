# The stock Yahboom (Sonix) wrist camera, fitted until 2026-09-24 (cameras/README.md).
# To go back to it, on the robot, with the Sonix plugged in again:
#   cp cameras/sonix.env robot.local.env
#   systemctl --user restart roboarm-vision roboarm-web
# and on the laptop, before starting the panel: set ROBOARM_CAMERA=sonix
# Delete robot.local.env (and restart both) to return to the C930e. LF line ends: systemd reads it.
ROBOARM_CAMERA=sonix
ROBOARM_WRIST_CAM=/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._USB_2.0_Camera-video-index0

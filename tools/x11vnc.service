[Unit]
# Serve the already-running GNOME X session over VNC, so the robot can be used
# with no monitor attached. Xorg already has AllowEmptyInitialConfiguration=true
# and gdm autologs in as jetson, so a real session exists on :0 even headless.
Description=x11vnc - serve the local X session over VNC (localhost only)
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
# -localhost : listen on 127.0.0.1 ONLY. Reachable only through an SSH tunnel,
#              so it adds no network exposure and needs no VNC password -- the
#              trust boundary stays exactly the machine's existing SSH access.
# -auth guess: locate whichever Xauthority the running session uses (gdm or user)
# -loop      : keep retrying if X is not up yet, or restarts underneath us
# -forever   : do not exit when the last viewer disconnects
ExecStart=/usr/bin/x11vnc -display :0 -auth guess -localhost -nopw -forever -loop -shared -rfbport 5900
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
